SPRING_PROFILES_ACTIVE=dev
HTTP_PORT=80
APP_SERVER_BASE_URL=http://localhost
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
SECURITY_JWT_SECRET=
# Docker requires a private frontend credential by default. Optional independent key:
SECURITY_FRONTEND_ACCESS_ENABLED=true
SECURITY_FRONTEND_ACCESS_SECRET=
# When empty, derive the Vercel API_FRONTEND_KEY from SECURITY_JWT_SECRET as documented.
SECURITY_BOOTSTRAP_ADMIN_ENABLED=true
ADMIN_PASSWORD=
# Fictitious bootstrap identity for testing
ADMIN_EMAIL=admin@localhost.com
ADMIN_CPF=12345678909
# SMTP intentionally empty in dev
SPRING_MAIL_HOST=
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
APP_MAIL_FROM=
SPRING_MAIL_PORT=587
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_SMTP_STARTTLS_REQUIRED=true
# Configure actual frontend URLs before switching to prod.
APP_PASSWORD_RESET_URL=http://localhost:3000/password-recovery/reset
APP_MEMBERSHIP_ACTIVATION_URL=http://localhost:3000/membership/activate

# Browser frontend origins, separated by commas.
APP_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
