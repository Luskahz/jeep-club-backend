SPRING_PROFILES_ACTIVE=dev
HTTP_PORT=80
APP_SERVER_BASE_URL=http://localhost
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
SECURITY_JWT_SECRET=
# Docker requires a private frontend credential by default. Optional independent key:
SECURITY_FRONTEND_ACCESS_ENABLED=true
SECURITY_FRONTEND_ACCESS_SECRET=
# When empty, derive the Vercel API_FRONTEND_KEY from SECURITY_JWT_SECRET as documented.
SECURITY_BOOTSTRAP_ADMIN_ENABLED=true
ADMIN_PASSWORD=
# Fictitious bootstrap identity for testing
ADMIN_EMAIL=admin@localhost.com
ADMIN_CPF=12345678909
# SMTP intentionally empty in dev
SPRING_MAIL_HOST=
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
APP_MAIL_FROM=
SPRING_MAIL_PORT=587
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_SMTP_STARTTLS_REQUIRED=true
SPRING_MAIL_SMTP_CONNECTION_TIMEOUT=5000
SPRING_MAIL_SMTP_READ_TIMEOUT=10000
SPRING_MAIL_SMTP_WRITE_TIMEOUT=10000
# Configure actual frontend URLs before switching to prod.
APP_PASSWORD_RESET_URL=http://localhost:3000/password-recovery/reset
APP_MEMBERSHIP_ACTIVATION_URL=http://localhost:3000/membership/activate
APP_ACCOUNT_ACTIVATION_URL=http://localhost:3000/account/activate
APP_ACCOUNT_ACTIVATION_TTL=PT24H
# Set true with an HTTPS activation URL when the frontend migrates; HTTP is temporarily accepted.
APP_ACCOUNT_ACTIVATION_REQUIRE_HTTPS=false

# Browser frontend origins, separated by commas.
APP_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# BACK-526: numeric policy is approved; production activation is a separate authorization.
# Real import apply also requires separate authorization; dry-run stays available.
MEMBERSHIPS_REGISTRY_IMPORTS_APPLY_ENABLED=false
MEMBERSHIPS_REGISTRY_ISSUANCE_ENABLED=false
MEMBERSHIPS_REGISTRY_ISSUANCE_APPROVED=false
# Remove retired INITIAL_NUMBER, WIDTH and PREFIX settings. Nonempty legacy format
# configuration fails startup explicitly, even when issuance is disabled.
