STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT_DIRECTORY=./storage
# Production requires the prod profile; otherwise the dev/test dummy mail adapters are active.
SPRING_PROFILES_ACTIVE=prod
# Required when SPRING_PROFILES_ACTIVE=prod.
APP_PASSWORD_RESET_URL=http://localhost:3000/password-recovery/reset
APP_MEMBERSHIP_ACTIVATION_URL=http://localhost:3000/membership/activate
APP_MAIL_FROM=no-reply@example.com
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=replace-me
SPRING_MAIL_PASSWORD=replace-me
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS_ENABLE=true
SPRING_MAIL_SMTP_STARTTLS_REQUIRED=true
