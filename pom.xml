<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
             http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.4</version>
        <relativePath/>
    </parent>

    <groupId>com.jeepclub</groupId>
    <artifactId>backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <name>backend</name>
    <description>Jeep Club Backend</description>

    <properties>
        <java.version>17</java.version>
        <jjwt.version>0.12.5</jjwt.version>
        <jetbrains.annotations.version>26.1.0</jetbrains.annotations.version>
        <mockito.version>5.20.0</mockito.version>
        <jacoco.version>0.8.15</jacoco.version>
        <pitest.version>1.19.0</pitest.version>
        <pitest.junit5.plugin.version>1.2.3</pitest.junit5.plugin.version>
        <surefireArgLine></surefireArgLine>
        <skipUnitTests>false</skipUnitTests>
    </properties>

    <dependencies>
        <dependency>
            <groupId>dev.matrixlab.webp4j</groupId>
            <artifactId>webp4j-core</artifactId>
            <version>2.5.0</version>
        </dependency>
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.6</version>
        </dependency>

        <!-- ========================= -->
        <!-- SPRING BOOT               -->
        <!-- ========================= -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- ========================= -->
        <!-- JWT                       -->
        <!-- ========================= -->

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ========================= -->
        <!-- BANCO DE DADOS            -->
        <!-- ========================= -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-mysql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>



        <!-- ========================= -->
        <!-- UTILITÁRIOS               -->
        <!-- ========================= -->

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>${jetbrains.annotations.version}</version>
        </dependency>

        <!-- ========================= -->
        <!-- DOCUMENTAÇÃO DA API       -->
        <!-- ========================= -->

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.0.3</version>
        </dependency>

        <!-- ========================= -->
        <!-- TESTES                    -->
        <!-- ========================= -->

        <!-- JUnit, Mockito, AssertJ e infraestrutura geral de testes -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testes Spring MVC e MockMvc no Spring Boot 4 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Auto-configuração do Spring REST Docs -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-restdocs</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Integração do Spring REST Docs com MockMvc -->
        <dependency>
            <groupId>org.springframework.restdocs</groupId>
            <artifactId>spring-restdocs-mockmvc</artifactId>
            <version>4.0.0</version>
            <scope>test</scope>
        </dependency>

        <!-- Banco em memória para testes de persistência e integração -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Slice de testes JPA no Spring Boot 4 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <!-- ========================= -->
            <!-- COMPILAÇÃO                -->
            <!-- ========================= -->

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>

                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                        <path>
                            <groupId>org.hibernate.orm</groupId>
                            <artifactId>hibernate-processor</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- ========================= -->
            <!-- SPRING BOOT               -->
            <!-- ========================= -->

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>

                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{surefireArgLine} -javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar</argLine>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <configuration>
                            <propertyName>surefireArgLine</propertyName>
                        </configuration>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>membership-report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                        <configuration>
                            <includes><include>com/jeepclub/backend/memberships/**</include></includes>
                            <outputDirectory>${project.reporting.outputDirectory}/jacoco-membership</outputDirectory>
                            <formats><format>HTML</format><format>XML</format><format>CSV</format></formats>
                        </configuration>
                    </execution>
                    <execution>
                        <id>authentication-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>com/jeepclub/backend/authentication/**</include>
                                <include>com/jeepclub/backend/iam/authentication/**</include>
                            </includes>
                            <outputDirectory>${project.reporting.outputDirectory}/jacoco-authentication</outputDirectory>
                            <formats>
                                <format>HTML</format>
                                <format>XML</format>
                                <format>CSV</format>
                            </formats>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <version>${pitest.version}</version>
                <dependencies>
                    <dependency>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-junit5-plugin</artifactId>
                        <version>${pitest.junit5.plugin.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <targetClasses>
                        <param>com.jeepclub.backend.dependents.*</param>
                    </targetClasses>
                    <targetTests>
                        <param>com.jeepclub.backend.dependents.*</param>
                    </targetTests>
                    <excludedClasses>
                        <param>com.jeepclub.backend.dependents.api.http.dto.*</param>
                    </excludedClasses>
                    <outputFormats>
                        <param>HTML</param>
                        <param>XML</param>
                    </outputFormats>
                    <timestampedReports>false</timestampedReports>
                    <threads>2</threads>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Invoke only jacoco:merge jacoco:report after separate successful unit/MySQL runs. -->
        <profile>
            <id>hardening-coverage-merge</id>
            <build><plugins><plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <configuration>
                    <fileSets><fileSet>
                        <directory>${project.build.directory}</directory>
                        <includes><include>hardening-unit.exec</include><include>hardening-mysql.exec</include></includes>
                    </fileSet></fileSets>
                    <destFile>${project.build.directory}/hardening-merged.exec</destFile>
                    <dataFile>${project.build.directory}/hardening-merged.exec</dataFile>
                </configuration>
            </plugin></plugins></build>
        </profile>
        <profile>
            <id>identity-hardening-mutation</id>
            <build><plugins><plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <configuration>
                    <targetClasses combine.self="override">
                        <param>com.jeepclub.backend.iam.identity.core.domain.model.User</param>
                        <param>com.jeepclub.backend.iam.identity.core.application.service.user.UserQueryService</param>
                    </targetClasses>
                    <targetTests combine.self="override">
                        <param>com.jeepclub.backend.identity.core.domain.model.*</param>
                        <param>com.jeepclub.backend.iam.identity.core.application.service.user.*</param>
                        <param>com.jeepclub.backend.lifecycle.PrincipalLifecycleDomainTest</param>
                        <param>com.jeepclub.backend.identity.core.application.service.user.UserContextBoundaryIntegrationTest</param>
                    </targetTests>
                    <excludedClasses combine.self="override" />
                    <reportsDirectory>${project.build.directory}/pit-reports/identity</reportsDirectory>
                </configuration>
            </plugin></plugins></build>
        </profile>
        <profile>
            <id>authorization-hardening-mutation</id>
            <build><plugins><plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <configuration>
                    <targetClasses combine.self="override">
                        <param>com.jeepclub.backend.iam.authorization.core.domain.model.Role</param>
                        <param>com.jeepclub.backend.iam.authorization.core.domain.model.Permission</param>
                        <param>com.jeepclub.backend.iam.authorization.core.application.service.userrole.AdminUserRoleService</param>
                        <param>com.jeepclub.backend.iam.authorization.core.application.service.role.AdminRoleService</param>
                        <param>com.jeepclub.backend.iam.authorization.core.application.service.rolepermission.AdminRolePermissionService</param>
                    </targetClasses>
                    <targetTests combine.self="override">
                        <param>com.jeepclub.backend.authorization.core.*</param>
                        <param>com.jeepclub.backend.iam.authorization.core.*</param>
                        <param>com.jeepclub.backend.authorization.AuthorizationAdministrationIntegrationTest</param>
                        <param>com.jeepclub.backend.lifecycle.PrincipalLifecycleDomainTest</param>
                        <param>com.jeepclub.backend.lifecycle.PrincipalLifecycleIntegrationTest</param>
                    </targetTests>
                    <excludedClasses combine.self="override" />
                    <reportsDirectory>${project.build.directory}/pit-reports/authorization</reportsDirectory>
                </configuration>
            </plugin></plugins></build>
        </profile>
        <profile>
            <id>publications-hardening-mutation</id>
            <build><plugins><plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <configuration>
                    <targetClasses combine.self="override">
                        <param>com.jeepclub.backend.publications.core.domain.model.EventRegistration</param>
                        <param>com.jeepclub.backend.publications.core.application.service.internal.EventParticipationRequirement</param>
                        <param>com.jeepclub.backend.publications.core.application.service.EventService</param>
                        <param>com.jeepclub.backend.publications.core.application.service.EventReportService</param>
                    </targetClasses>
                    <targetTests combine.self="override">
                        <param>com.jeepclub.backend.publications.core.*</param>
                        <param>com.jeepclub.backend.publications.EventOperationsIntegrationTest</param>
                    </targetTests>
                    <excludedClasses combine.self="override" />
                    <reportsDirectory>${project.build.directory}/pit-reports/publications</reportsDirectory>
                </configuration>
            </plugin></plugins></build>
        </profile>
        <profile>
            <id>platform-shared-hardening-mutation</id>
            <build><plugins><plugin>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-maven</artifactId>
                <configuration>
                    <targetClasses combine.self="override">
                        <param>com.jeepclub.backend.platform.storage.image.ImageMediaService</param>
                        <param>com.jeepclub.backend.platform.logging.SystemLogServiceAdapter</param>
                        <param>com.jeepclub.backend.platform.security.handler.ApiAccessDeniedHandler</param>
                        <param>com.jeepclub.backend.shared.export.ExportPages</param>
                        <param>com.jeepclub.backend.shared.storage.ImageReference</param>
                        <param>com.jeepclub.backend.shared.storage.StorageResource</param>
                        <param>com.jeepclub.backend.shared.storage.exception.StorageOperationException</param>
                    </targetClasses>
                    <targetTests combine.self="override">
                        <param>com.jeepclub.backend.platform.storage.image.ImageMediaServiceTest</param>
                        <param>com.jeepclub.backend.platform.storage.image.PrivateImageMediaContractTest</param>
                        <param>com.jeepclub.backend.platform.logging.SystemLogServiceAdapterTest</param>
                        <param>com.jeepclub.backend.platform.logging.SystemLogPersistenceWorkerTest</param>
                        <param>com.jeepclub.backend.platform.security.handler.*</param>
                        <param>com.jeepclub.backend.shared.*</param>
                    </targetTests>
                    <excludedClasses combine.self="override" />
                    <reportsDirectory>${project.build.directory}/pit-reports/platform-shared</reportsDirectory>
                </configuration>
            </plugin></plugins></build>
        </profile>
        <profile>
            <id>mysql-migrations</id>
            <build><plugins><plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration><skipTests>${skipUnitTests}</skipTests></configuration>
            </plugin><plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration><argLine>@{surefireArgLine}</argLine><includes><include>**/*MySqlIT.java</include><include>**/MySqlMigrationIT.java</include></includes></configuration>
                <executions><execution><goals>
                    <goal>integration-test</goal><goal>verify</goal>
                </goals></execution></executions>
            </plugin></plugins></build>
        </profile>
        <profile>
            <id>publications-postgresql</id>
            <build><plugins><plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration><skipTests>${skipUnitTests}</skipTests></configuration>
            </plugin><plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration><argLine>@{surefireArgLine}</argLine><includes><include>**/*PostgresIT.java</include></includes></configuration>
                <executions><execution><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions>
            </plugin></plugins></build>
        </profile>
        <profile>
            <id>membership-mutation</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <configuration>
                            <targetClasses combine.self="override">
                                <param>com.jeepclub.backend.memberships.core.domain.model.MembershipApplication</param>
                                <param>com.jeepclub.backend.memberships.core.domain.model.MembershipApplicantBlock</param>
                                <param>com.jeepclub.backend.memberships.core.domain.model.MemberActivationToken</param>
                                <param>com.jeepclub.backend.memberships.core.application.service.memberactivationtoken.MemberActivationTokenService</param>
                                <param>com.jeepclub.backend.memberships.core.application.service.membershipapplication.AdminMembershipApplicationService</param>
                                <param>com.jeepclub.backend.memberships.core.application.service.membershipapplication.MembershipApplicationService</param>
                            </targetClasses>
                            <targetTests combine.self="override">
                                <param>com.jeepclub.backend.memberships.core.*</param>
                            </targetTests>
                            <excludedClasses combine.self="override" />
                            <reportsDirectory>${project.build.directory}/pit-reports/membership</reportsDirectory>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>health-mutation</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <configuration>
                            <targetClasses combine.self="override">
                                <param>com.jeepclub.backend.health.core.domain.model.MedicalProfile</param>
                                <param>com.jeepclub.backend.health.core.domain.model.MedicalProfileData</param>
                                <param>com.jeepclub.backend.health.core.application.service.medicalprofile.MedicalProfileService</param>
                                <param>com.jeepclub.backend.health.core.application.service.medicalprofile.AdminMedicalProfileService</param>
                            </targetClasses>
                            <targetTests combine.self="override">
                                <param>com.jeepclub.backend.health.core.*</param>
                                <param>com.jeepclub.backend.health.api.http.dto.*</param>
                            </targetTests>
                            <excludedClasses combine.self="override" />
                            <reportsDirectory>${project.build.directory}/pit-reports/health</reportsDirectory>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>billing-mutation</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <configuration>
                            <targetClasses combine.self="override">
                                <param>com.jeepclub.backend.billing.core.domain.model.MemberCharge</param>
                                <param>com.jeepclub.backend.billing.core.domain.model.MemberPayment</param>
                                <param>com.jeepclub.backend.billing.core.domain.model.MemberRefund</param>
                                <param>com.jeepclub.backend.billing.core.domain.model.ChargeDefinition</param>
                                <param>com.jeepclub.backend.billing.core.domain.model.ChargeCycle</param>
                                <param>com.jeepclub.backend.billing.core.domain.model.assignment.*</param>
                                <param>com.jeepclub.backend.billing.core.application.service.membercharge.*</param>
                                <param>com.jeepclub.backend.billing.core.application.service.memberpayment.*</param>
                                <param>com.jeepclub.backend.billing.core.application.service.memberrefund.*</param>
                                <param>com.jeepclub.backend.billing.core.application.service.chargedefinition.*</param>
                                <param>com.jeepclub.backend.billing.core.application.service.chargeassignment.*</param>
                                <param>com.jeepclub.backend.billing.core.application.service.chargecycle.*</param>
                                <param>com.jeepclub.backend.billing.core.application.service.event.*</param>
                            </targetClasses>
                            <targetTests combine.self="override">
                                <param>com.jeepclub.backend.billing.*</param>
                            </targetTests>
                            <excludedClasses combine.self="override" />
                            <outputDirectory>${project.build.directory}/pit-reports/billing</outputDirectory>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>tools-mutation</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <configuration>
                            <targetClasses combine.self="override">
                                <param>com.jeepclub.backend.tools.core.domain.model.Tool</param>
                                <param>com.jeepclub.backend.tools.core.application.service.tool.ToolService</param>
                                <param>com.jeepclub.backend.tools.core.application.service.tool.AdminToolService</param>
                            </targetClasses>
                            <targetTests combine.self="override">
                                <param>com.jeepclub.backend.tools.core.application.service.tool.*</param>
                            </targetTests>
                            <excludedClasses combine.self="override" />
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>authentication-mutation</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <configuration>
                            <targetClasses combine.self="override">
                                <param>com.jeepclub.backend.iam.authentication.core.domain.model.Session</param>
                                <param>com.jeepclub.backend.iam.authentication.core.domain.model.RefreshToken</param>
                                <param>com.jeepclub.backend.iam.authentication.core.domain.model.PasswordRecoveryRequest</param>
                                <param>com.jeepclub.backend.iam.authentication.core.domain.model.AuthenticationAccount</param>
                                <param>com.jeepclub.backend.iam.authentication.core.application.service.refreshtoken.RefreshTokenService</param>
                            </targetClasses>
                            <targetTests combine.self="override">
                                <param>com.jeepclub.backend.authentication.core.domain.model.*</param>
                                <param>com.jeepclub.backend.authentication.core.application.service.refreshtoken.*</param>
                                <param>com.jeepclub.backend.iam.authentication.core.*</param>
                            </targetTests>
                            <excludedClasses combine.self="override" />
                            <reportsDirectory>${project.build.directory}/pit-reports/authentication</reportsDirectory>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
