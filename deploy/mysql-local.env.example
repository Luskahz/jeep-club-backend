# Copie para .env.local na raiz do backend. Esse arquivo local é ignorado pelo Git.
# Usado pelo Docker Compose; o Spring Boot no IntelliJ não lê .env.local automaticamente.
MYSQL_LOCAL_PORT=3307
# Escolha uma senha local e repita-a em spring.datasource.password no application-dev.properties.
MYSQL_PASSWORD=CHANGE_ME
# Senha diferente para administração do MySQL. A aplicação usa o usuário jeepclub.
MYSQL_ROOT_PASSWORD=CHANGE_ME
